{
  "name": "@nera/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "typecheck": "prisma generate --schema=./prisma/schema.prisma && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:validate": "prisma validate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma --skip-generate",
    "db:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:check-connection": "tsx src/validateConnection.ts",
    "db:bootstrap-rls-role": "tsx src/bootstrapRlsTestRole.ts",
    "db:bootstrap-app-role": "tsx src/bootstrapAppRole.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.3",
    "dotenv": "^16.4.3"
  },
  "devDependencies": {
    "prisma": "^6.8.3",
    "tsx": "^4.20.3",
    "typescript": "^5.6.3"
  }
}
